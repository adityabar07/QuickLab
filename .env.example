# ============================================================
# QuickLab Environment Configuration Template
# Copy to .env for local development (DO NOT commit .env to Git)
# ============================================================

# --- Backend Configuration (FastAPI & Docker Sandbox) ---
QUICKLAB_ENV=development
HOST=0.0.0.0
PORT=8000

# Configurable CORS: Comma-separated list of allowed frontend origins (e.g. your deployed Vercel domain)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:8000

# Execution Resource Limits
EXECUTION_TIMEOUT_SECONDS=15
MAX_OUTPUT_BYTES=5242880
MAX_ACTIVE_SESSIONS=200
SESSION_IDLE_TIMEOUT_SECONDS=1800
SANDBOX_DIR=./sessions

# Rate Limiting (requests per minute)
RATE_LIMIT_EXECUTE_PER_MIN=60
RATE_LIMIT_UPLOAD_PER_MIN=20
RATE_LIMIT_SESSION_PER_MIN=30
RATE_LIMIT_GLOBAL_PER_MIN=180

# --- Frontend Configuration (Vercel & Vite) ---
# For local dev with Vite proxy: leave blank or use http://localhost:8000
# For Vercel production: set to your deployed backend URL (e.g. https://your-backend.onrender.com)
VITE_API_URL=
